# ═══════════════════════════════════════════════════════════════
# YoriNetflix — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════


# ── REQUIRED ───────────────────────────────────────────────────

# Telegram Bot API token (get from @BotFather)
BOT_TOKEN=

# Comma-separated Telegram user IDs with admin privileges
# Example: 123456789,987654321
ADMIN_IDS=

# Neon PostgreSQL connection string
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=


# ── TELEGRAM (optional) ───────────────────────────────────────

# Channel username for force-subscription (without @)
# Leave empty to disable FSUB checks
FORCE_CHANNEL=

# Invite link for the FSUB channel (required when FORCE_CHANNEL is set)
FORCE_CHANNEL_URL=

# URL of the welcome video (leave empty for text-only welcome)
START_VIDEO_URL=


# ── LIMITS (optional) ─────────────────────────────────────────

# Seconds between generations per user (default: 120)
COOLDOWN_SECONDS=120

# Maximum generations per user per UTC day (default: 5)
DAILY_GENERATION_LIMIT=5

# Points for daily reward claim (default: 10)
DAILY_REWARD_POINTS=10

# Points per successful referral (default: 25)
REFERRAL_REWARD_POINTS=25

# Points earned per generation, 0 = none (default: 0)
POINTS_PER_GENERATION=0


# ── FSUB BEHAVIOR (optional) ──────────────────────────────────

# If true, allow users through when membership check errors.
# Default: false (fail-closed — safer for production)
FSUB_FAIL_OPEN=false


# ── THROTTLE (optional) ───────────────────────────────────────

# Minimum seconds between actions per user (default: 0.5)
THROTTLE_RATE=0.5


# ── PAGINATION (optional) ─────────────────────────────────────

# Items per page in country list and history (default: 12)
PAGE_SIZE=12


# ── LOGGING (optional) ────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Directory for log files (default: logs)
LOG_DIR=logs

# Directory for backup files (default: backups)
BACKUP_DIR=backups